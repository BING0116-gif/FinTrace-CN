# vynn-core Configuration Template
# Copy this to .env and update with your actual values

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=your-database-name
OPENAI_API_KEY=sk-xxx
SERPAPI_API_KEY=your-serpapi-key
ANTHROPIC_API_KEY=sk-ant-xxx

# DeepSeek (default LLM provider — deepseek-v4-flash)
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-deepseek-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# v1 does NOT support DeepSeek thinking mode; keep this false.
# Setting DEEPSEEK_THINKING_ENABLED=true will raise an error at init.
DEEPSEEK_THINKING_ENABLED=false
