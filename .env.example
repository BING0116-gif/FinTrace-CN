# FinTrace-CN optional integrations. Offline demo and tests need no secrets.
TUSHARE_TOKEN=

# Only required for real (non-dry-run) Agent evaluation.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional writable cache root. Defaults to ./data/.cache.
FINTRACE_CACHE_DIR=
